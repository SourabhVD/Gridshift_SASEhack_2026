# Environment and secrets
.env
.env.*
!.env.example
credentials/
credentials.json
*.pem
*.key

# Python virtual environments
.venv/
venv/
env/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Frontend dependencies and builds
frontend/node_modules/
frontend/.next/

# Generated data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# IDE files
.idea/
.vscode/
*.swp

# Large model files
*.joblib
*.pkl
*.pickle
*.onnx
*.h5
*.pt
*.pth

# Generated by the optimizer's CLI, and by the fixture-truth dumper the
# frontend verifier reads. Both are reproducible from a command, so
# neither belongs in the history.
optimizer/output/
backend_truth.json

# The backtest artifacts the backend actually reads: three small files a day,
# about 4 KB each. They are the demo's data -- without them a clone falls back
# to the authored fixtures and none of the real-day work is visible. The
# trained bundle written beside them is 1.4 MB a day, is regenerable from
# `ml/evaluate_forecast_date.py --date`, and stays out.
!data/processed/backtests/
data/processed/backtests/*/*
!data/processed/backtests/*/forecast_vs_actual.csv
!data/processed/backtests/*/metrics.json
!data/processed/backtests/*/metadata.json
