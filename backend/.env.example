# ---------------------------------------------------------------------------
# GridShift backend. Copy to backend/.env and edit.
# Nothing here is required: the defaults run the whole API with no API key.
# ---------------------------------------------------------------------------

# Google AI Studio key. Only read when GRIDSHIFT_AGENT=gemini.
# The frontend must never see this value.
GEMINI_API_KEY=

# fake   -> scripted 14-step run that calls the real tools (no key needed)
# gemini -> google-genai function calling against GEMINI_MODEL
GRIDSHIFT_AGENT=fake

# Model id used when GRIDSHIFT_AGENT=gemini.
GEMINI_MODEL=gemini-2.5-flash

# ortools   -> CP-SAT model: all three levers at once, peak then cost
# heuristic -> the fixed-order three-lever pass the README's figures came from
GRIDSHIFT_OPTIMIZER=ortools

# fixtures -> serve the ported demo curves
# ml       -> call the teammate's ml package in process
# backtest -> serve a real day that ml/evaluate_forecast_date.py already wrote
# Anything unavailable falls back to fixtures with one logged warning.
GRIDSHIFT_FORECAST=fixtures

# Where the trained bundle lives. Relative paths resolve from the repo root.
GRIDSHIFT_ML_MODEL_PATH=ml/artifacts/load_forecaster.joblib

# --- backtest mode ---------------------------------------------------------
# Produce a day first, from the repo root, with DATABASE_URL set in ./.env:
#   python -m ml.evaluate_forecast_date --date 2018-07-15
# That reads the database and writes one directory per date. This backend only
# reads those files: no database connection, no credential, no retraining.

# Where those directories live. Relative paths resolve from the repo root.
GRIDSHIFT_BACKTEST_PATH=data/processed/backtests

# Which date to serve. Empty means the most recent one present.
GRIDSHIFT_BACKTEST_DATE=

# The one site the backtest speaks for. The database holds a single building,
# so every other slug keeps its fixture curve.
GRIDSHIFT_BACKTEST_BUILDING=sea-office-001

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Multiplies every simulated agent delay. 0 makes a run finish instantly,
# which is what the test suite uses. 1.0 is the ~17 s demo pace.
GRIDSHIFT_AGENT_SPEED=1.0
