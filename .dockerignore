# Keep the build context small and keep secrets out of it. Both Dockerfiles
# build from the repository root, so without this the context is the whole
# repo: node_modules, the ml artifacts, .git, and anyone's .env.
.git
.github
**/node_modules
**/.next
**/__pycache__
**/*.pyc
.venv
**/.venv
.claude

# Never. The backend takes its key at run time, not baked into a layer.
.env
**/.env
**/.env.local
**/.env.*.local

# Generated, and regenerated by a command.
backend_truth.json
optimizer/output
data/raw
ml/artifacts
