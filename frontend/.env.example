# ---------------------------------------------------------------------------
# GridShift frontend environment
# Copy to .env.local and edit. Both vars are NEXT_PUBLIC_*, so they are inlined
# into the client bundle at build time -- restart `npm run dev` after changing.
# ---------------------------------------------------------------------------

# 'true'    -> serve every endpoint from the in-memory fixtures in src/mocks.
#              This is the default when the variable is unset or unrecognized,
#              so the app runs standalone with no backend at all.
# 'false'   -> send every endpoint to the real FastAPI backend at
#              NEXT_PUBLIC_API_BASE_URL. Failures surface as errors in the UI.
# 'partial' -> integration mode: try the backend first and fall back to the
#              mock per endpoint it does not serve yet (down, 404/501/502/503/
#              504, or a malformed payload). See "Integrating a real backend"
#              in README.md; the console names each endpoint that falls back.
NEXT_PUBLIC_USE_MOCK=true

# Origin of the FastAPI backend. No trailing slash; paths like
# /api/dashboard/summary are appended. Used when USE_MOCK is 'false' or 'partial'.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
