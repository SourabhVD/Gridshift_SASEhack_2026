# ---------------------------------------------------------------------------
# GridShift frontend environment
# Copy to .env.local and edit. Both vars are NEXT_PUBLIC_*, so they are inlined
# into the client bundle at build time -- restart `npm run dev` after changing.
# ---------------------------------------------------------------------------

# 'true'  -> serve fixtures from src/mocks (no backend needed). This is the
#            default when the variable is unset, so the app runs standalone.
# 'false' -> hit the real FastAPI backend at NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_USE_MOCK=true

# Origin of the FastAPI backend. No trailing slash; paths like
# /api/dashboard/summary are appended. Only used when USE_MOCK is 'false'.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
